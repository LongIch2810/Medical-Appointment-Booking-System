# Env dùng riêng cho integration test (backend/test/**/*.integration-spec.ts).
# KHÔNG dùng file này cho dev/production. DB_NAME bắt buộc có hậu tố "_test" —
# đây là safeguard mà backend/test/setup/jestSetupAfterEnv.ts kiểm tra để
# chống chạy nhầm integration test vào DB dev.
#
# Postgres và Redis ở đây là instance của docker-compose.dev.yml (chạy
# `docker compose -f docker-compose.dev.yml up -d postgres redis` trước khi
# chạy integration test) — database test (DB_NAME) được tự tạo bởi
# globalSetup.ts nếu chưa tồn tại, KHÔNG động tới database dev
# (booking_doctor_db). Redis dùng chung instance dev nhưng:
#   - RedisCacheService bị override bằng fake in-memory trong test-app.factory.ts
#     (không đụng dữ liệu cache/session thật trong Redis DB 0).
#   - EmailProducer bị override bằng stub (không enqueue job email thật) dù
#     BullMQ (Redis DB 1) vẫn cần kết nối được để app khởi động.

NODE_ENV=test

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=booking_doctor_db_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

ACCESS_TOKEN_SECRET=test_access_token_secret
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_SECRET=test_refresh_token_secret
REFRESH_TOKEN_EXPIRE=7d

FRONTEND_URL=http://localhost:5183
CHATBOT_URL=http://localhost:5000

MAIL_USER=test@example.com
MAIL_PASS=test-mail-password

CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALL_BACK=http://localhost:3010/api/v1/auth/google/redirect

PORT=3010
