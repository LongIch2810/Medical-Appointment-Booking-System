PORT=3000
# development | production | test — controls cookie `secure` (HTTPS-only in
# production) among other environment-specific behavior. Must be set to
# "production" on the deployed server.
NODE_ENV=development
# Keep 0 for direct connections; use 1 behind a single Nginx/Caddy proxy.
TRUST_PROXY_HOPS=0

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Upstash supports database 0 only; separate workloads by key prefixes.
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_BULLMQ_DB=0
REDIS_RATE_LIMIT_DB=0

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALL_BACK=http://localhost:3010/api/v1/auth/google/redirect

FRONTEND_URL=http://localhost:5183
CHATBOT_URL=http://localhost:5000
# Must match chatbot/.env; use a random value with at least 32 characters.
CHATBOT_INTERNAL_KEY=
# Must match chatbot/.env; use a strong value with at least 16 characters.
CHATBOT_DB_PASSWORD=

MAIL_USER=
MAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Tham chiếu các biến môi trường ---
# PORT: Cổng HTTP mà backend lắng nghe bên trong môi trường chạy.
# NODE_ENV: Môi trường chạy (`development`, `test` hoặc `production`).
# TRUST_PROXY_HOPS: Số proxy đáng tin cậy phía trước backend; dùng `0` khi kết nối trực tiếp.
# DB_USER: Tên người dùng PostgreSQL của backend.
# DB_PASSWORD: Mật khẩu PostgreSQL của backend.
# DB_NAME: Tên database PostgreSQL của ứng dụng.
# DB_HOST: Hostname PostgreSQL; trong Docker dùng tên service `postgres`.
# DB_PORT: Cổng PostgreSQL.
# REDIS_HOST: Hostname Redis; trong Docker dùng tên service `redis`.
# REDIS_PORT: Cổng Redis.
# REDIS_PASSWORD: Mật khẩu xác thực Redis.
# REDIS_TLS: Đặt `true` khi Redis yêu cầu TLS, ví dụ Upstash Redis.
# REDIS_DB: Chỉ số Redis database; Upstash chỉ hỗ trợ `0`.
# REDIS_CACHE_DB: DB riêng cho backend cache; mặc định `0`.
# REDIS_BULLMQ_DB: DB riêng cho các job BullMQ; mặc định `0`.
# REDIS_RATE_LIMIT_DB: DB riêng cho backend rate-limit; mặc định `0`.
# ACCESS_TOKEN_SECRET: Khóa ký JWT access token; phải trùng với chatbot để xác minh actor.
# ACCESS_TOKEN_EXPIRE: Thời gian sống của access token, ví dụ `15m`.
# REFRESH_TOKEN_SECRET: Khóa ký JWT refresh token, phải khác access-token secret.
# REFRESH_TOKEN_EXPIRE: Thời gian sống của refresh token, ví dụ `7d`.
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID do Google cấp.
# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret do Google cấp.
# GOOGLE_CALL_BACK: URL callback Google OAuth đã đăng ký.
# FRONTEND_URL: Origin Patient UI được phép dùng trong CORS/chuyển hướng.
# CHATBOT_URL: Base URL nội bộ của chatbot; trong Docker dùng `http://chatbot:5000`.
# CHATBOT_INTERNAL_KEY: Khóa bí mật xác thực các request backend → chatbot.
# CHATBOT_DB_PASSWORD: Mật khẩu database role chỉ đọc dành cho chatbot.
# MAIL_USER: Tài khoản SMTP dùng để gửi email hệ thống.
# MAIL_PASS: Mật khẩu ứng dụng hoặc credential SMTP.
# CLOUDINARY_CLOUD_NAME: Tên Cloudinary cloud chứa tài nguyên upload.
# CLOUDINARY_API_KEY: API key của Cloudinary.
# CLOUDINARY_API_SECRET: API secret của Cloudinary; không được gửi xuống client.
# Thay toàn bộ placeholder bằng giá trị riêng an toàn và không commit file `.env` thật.
