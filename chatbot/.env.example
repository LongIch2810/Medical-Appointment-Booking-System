PORT=5000
# Set true only for a persistent Node server; keep false on Vercel.
START_STANDALONE_SERVER=false
# Must match backend/.env; use a random value with at least 32 characters.
CHATBOT_INTERNAL_KEY=
# Must match backend/.env's ACCESS_TOKEN_SECRET exactly — chatbot verifies
# the user's own access token (forwarded by backend) to derive a trusted
# actor identity for rate limiting, instead of trusting client-supplied
# userId.
ACCESS_TOKEN_SECRET=

# Redis-backed rate limiter — required so multiple chatbot replicas share
# one quota per user instead of each replica keeping its own in-memory
# bucket. Reuses the same Redis instance as backend; workloads are separated
# by key prefixes.
REDIS_URL=
# Local/Docker fallback when REDIS_URL is empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_RATE_LIMIT_DB=0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-4.1-mini handles RAG, reports, SQL, medical reasoning, and the main
# agent's tool-calling — not a reasoning model, so no reasoning_effort is
# applied (see getReasoningEffort in configs/llm.ts). Chosen over the
# gpt-5 family for lower cost/latency; OpenAI reports it reduces tool-call
# selection errors relative to gpt-4o.
OPENAI_MODEL=gpt-4.1-mini
# Focused extraction, routing, chart configuration, and OCR use the cheaper model.
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
LLM_HEALTH_ROADMAP_MAX_RETRIES=2

# OpenAI is used directly for Qdrant document and query embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Must match backend/.env; this is the chatbot_readonly role password.
CHATBOT_DB_PASSWORD=
DB_USER=chatbot_readonly
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# Native LangGraph checkpointer + long-term preference store; must match backend/.env.
LANGGRAPH_DB_USER=chatbot_report_assistant
LANGGRAPH_DB_PASSWORD=

QDRANT_API_KEY=
QDRANT_URL=
QDRANT_COLLECTION_NAME=BOOKING_DOCTOR_SYSTEM_OPENAI_TE3_SMALL_V1

BACKEND_URL=http://localhost:3010
# Maximum number of recent messages sent to the chatbot agent per request.
CHAT_HISTORY_CONTEXT_LIMIT=10

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
# --- Tham chiếu các biến môi trường ---
# PORT: Cổng HTTP chatbot lắng nghe; mặc định luồng nội bộ dùng cổng `5000`.
# CHATBOT_INTERNAL_KEY: Khóa bí mật xác thực request nội bộ; phải trùng backend.
# ACCESS_TOKEN_SECRET: Khóa xác minh access token người dùng; phải trùng backend.
# REDIS_URL: URL Redis đầy đủ; trên Render dùng Internal Redis URL dạng `redis://...:6379`.
# REDIS_HOST: Hostname fallback khi REDIS_URL trống.
# REDIS_PORT: Cổng Redis.
# REDIS_PASSWORD: Mật khẩu xác thực Redis.
# REDIS_TLS: Chỉ áp dụng cho HOST/PORT; REDIS_URL tự suy ra TLS từ `redis://` hoặc `rediss://`.
# REDIS_RATE_LIMIT_DB: DB riêng cho rate limiter; mặc định `0`.
# OPENAI_API_KEY: API key dùng cho model chat, vision/OCR và embeddings khi chạy thật.
# OPENAI_BASE_URL: Base URL OpenAI hoặc endpoint tương thích OpenAI.
# OPENAI_MODEL: Model chính cho hội thoại, RAG, báo cáo và suy luận y tế.
# OPENAI_FAST_MODEL: Model chi phí thấp cho tác vụ trích xuất hoặc định tuyến nhanh.
# OPENAI_VISION_MODEL: Model hỗ trợ ảnh dùng cho OCR bệnh án.
# LLM_HEALTH_ROADMAP_MAX_RETRIES: Số lần thử lại tối đa khi tạo lộ trình sức khỏe.
# OPENAI_EMBEDDING_MODEL: Model tạo embeddings cho kho tri thức Qdrant.
# OPENAI_EMBEDDING_DIMENSIONS: Số chiều vector phải tương thích collection Qdrant.
# CHATBOT_DB_PASSWORD: Mật khẩu database role chỉ đọc dành riêng cho chatbot.
# DB_USER: Tên role chỉ đọc; với Supabase shared pooler dùng `chatbot_readonly.<PROJECT_REF>`.
# DB_NAME: Tên database chứa các view chỉ đọc cho chatbot.
# DB_HOST: Hostname PostgreSQL; trong Docker dùng tên service `postgres`.
# DB_PORT: Cổng PostgreSQL.
# QDRANT_API_KEY: API key truy cập Qdrant.
# QDRANT_URL: URL Qdrant server hoặc Qdrant Cloud cluster.
# QDRANT_COLLECTION_NAME: Tên collection vector chứa knowledge base.
# BACKEND_URL: Base URL nội bộ của backend; trong Docker dùng `http://backend:3000`.
# CLOUDINARY_API_KEY: API key của Cloudinary cho luồng upload báo cáo.
# CLOUDINARY_API_SECRET: API secret của Cloudinary.
# CLOUDINARY_CLOUD_NAME: Tên Cloudinary cloud chứa tài nguyên.
# Thay toàn bộ placeholder bằng giá trị riêng an toàn và không commit file `.env` thật.
