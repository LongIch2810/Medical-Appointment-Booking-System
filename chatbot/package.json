{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "postinstall": "npm run build",
    "start:prod": "node dist/server.js",
    "knowledge:build": "node --loader ts-node/esm src/scripts/buildKnowledgeBase.ts",
    "test": "node --loader ts-node/esm --import ./test/noExternalNetwork.ts --test \"test/**/*.spec.ts\"",
    "test:cov": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"test/**/*.spec.ts\" --loader ts-node/esm --import ./test/noExternalNetwork.ts --test \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "dependencies": {
